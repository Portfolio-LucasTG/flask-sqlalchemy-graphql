# Flask
APP_ENV=development
FLASK_APP=wsgi:app
SECRET_KEY=change-me

# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flask_sqlalchemy_graphql
POSTGRES_PORT=5432

# Application database connection (SQLAlchemy URL, psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/flask_sqlalchemy_graphql

# Optional: dedicated PostgreSQL database for tests.
# If unset, tests run against an in-memory SQLite database.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/flask_sqlalchemy_graphql_test
